# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
.env
.venv/
ENV/

# Raw dataset files (exclude 850+ MB OPPORTUNITY dataset files)
data/raw/*
!data/raw/.gitkeep
*.dat
*.zip
*.tar.gz

# Processed data (exclude large .npz tensors, preserve metadata JSON schemas)
data/processed/*.npz
!data/processed/.gitkeep
!data/processed/*.json

# Checkpoints & heavy model weights
checkpoints/*.pt
checkpoints/*.pth
checkpoints/*.ckpt
!checkpoints/.gitkeep

# Temporary synthetic experiment directories
results/synthetic*

# Pytest, coverage, cache
.pytest_cache/
.coverage
htmlcov/
.cache

# Jupyter Notebooks checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini
